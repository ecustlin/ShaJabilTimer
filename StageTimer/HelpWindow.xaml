<Window x:Class="StageTimer.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="帮助" Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="#111111" Foreground="White"
        FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="14">
    <Window.Resources>
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,14,0,6" />
        </Style>
        <Style x:Key="Body" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#C8C8C8" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="LineHeight" Value="22" />
        </Style>
        <Style x:Key="Key" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontFamily" Value="Consolas, Segoe UI" />
            <Setter Property="Margin" Value="0,2,16,2" />
        </Style>
        <Style x:Key="KeyDesc" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#C8C8C8" />
            <Setter Property="Margin" Value="0,2,0,2" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="22,8,22,20">
        <TextBlock Text="基本操作" Style="{StaticResource Section}" />
        <TextBlock Style="{StaticResource Body}">
            • 点击数字旁的上下箭头（按住可连续调整），或在数字上滚动鼠标滚轮设定时间。<LineBreak />
            • 剩余时间低于提醒阈值时数字变黄，到时后变红并显示超时时长。<LineBreak />
            • 拖动窗口任意空白处移动位置，拖动右下角调整大小，数字随窗口缩放。<LineBreak />
            • 双击计时区域切换紧凑模式（只显示时间），适合叠放在幻灯片角落。
        </TextBlock>

        <TextBlock Text="全局快捷键（PPT 放映时也可用）" Style="{StaticResource Section}" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Style="{StaticResource Key}" Text="Ctrl + Alt + S" />
            <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource KeyDesc}" Text="开始 / 暂停 / 继续" />
            <TextBlock Grid.Row="1" Style="{StaticResource Key}" Text="Ctrl + Alt + R" />
            <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource KeyDesc}" Text="重置" />
            <TextBlock Grid.Row="2" Style="{StaticResource Key}" Text="Ctrl + Alt + M" />
            <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource KeyDesc}" Text="切换紧凑模式" />
            <TextBlock Grid.Row="3" Style="{StaticResource Key}" Text="Ctrl + Alt + H" />
            <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource KeyDesc}" Text="隐藏 / 显示计时器" />
        </Grid>
        <TextBlock x:Name="HotkeyWarning" Foreground="#FFB020" TextWrapping="Wrap" Margin="0,8,0,0"
                   Visibility="Collapsed" />

        <TextBlock Text="PPT 放映提示" Style="{StaticResource Section}" />
        <TextBlock Style="{StaticResource Body}">
            • 先打开计时器，再开始放映，计时器会保持在放映画面之上。<LineBreak />
            • 使用演讲者视图（双屏）时，可把计时器拖到演讲者屏幕，观众看不到。<LineBreak />
            • 单屏放映时建议切换到紧凑模式并调低不透明度，放在不挡内容的角落。
        </TextBlock>

        <DockPanel Margin="0,20,0,0">
            <Button DockPanel.Dock="Right" Content="知道了" IsDefault="True" IsCancel="True"
                    Style="{StaticResource DialogButton}" Click="Ok_Click" />
            <TextBlock Text="Design by jabilSHAIT" Foreground="#707070" FontSize="12" VerticalAlignment="Center" />
        </DockPanel>
    </StackPanel>
</Window>
