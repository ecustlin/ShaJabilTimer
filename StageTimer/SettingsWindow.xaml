<Window x:Class="StageTimer.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置" Width="400" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="#111111" Foreground="White"
        FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="14">
    <Window.Resources>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#1C1C1C" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#3A3A3A" />
            <Setter Property="CaretBrush" Value="White" />
            <Setter Property="Padding" Value="6,4" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#A8A8A8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="22,18,22,20">
        <TextBlock Text="剩余多少秒时数字变黄提醒（0 = 不提醒）" Style="{StaticResource Hint}" />
        <TextBox x:Name="WarningBox" Margin="0,6,0,18" />

        <CheckBox x:Name="AllowOvertimeBox" Content="到时后继续计时，显示超时时长" />
        <CheckBox x:Name="FlashBox" Content="超时后红色闪烁" />
        <CheckBox x:Name="SoundBox" Content="到时播放提示音" />
        <CheckBox x:Name="TopmostBox" Content="窗口始终置顶（覆盖在 PPT 放映之上）" />
        <CheckBox x:Name="NoActivateBox" Content="点击计时器时不抢走 PPT 的键盘焦点（推荐）" Margin="0,0,0,4" />
        <TextBlock Style="{StaticResource Hint}" Margin="22,0,0,16"
                   Text="开启后翻页笔和方向键始终控制幻灯片；计时器的键盘快捷键请使用 Ctrl+Alt 全局快捷键。" />

        <TextBlock Text="窗口不透明度" Style="{StaticResource Hint}" />
        <DockPanel Margin="0,6,0,0">
            <TextBlock x:Name="OpacityLabel" DockPanel.Dock="Right" Width="48" TextAlignment="Right"
                       VerticalAlignment="Center" />
            <Slider x:Name="OpacitySlider" Minimum="0.3" Maximum="1" TickFrequency="0.05"
                    IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="OpacitySlider_ValueChanged" />
        </DockPanel>

        <TextBlock x:Name="ErrorText" Foreground="#FF6B6B" Margin="0,12,0,0" Visibility="Collapsed" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button Content="取消" IsCancel="True" Style="{StaticResource DialogButton}" />
            <Button Content="保存" IsDefault="True" Style="{StaticResource DialogButton}" Background="#22A45D"
                    Click="Save_Click" />
        </StackPanel>
    </StackPanel>
</Window>
